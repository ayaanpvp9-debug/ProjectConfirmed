# ---------------------------------------------------------------------------
# ACADEMIA — environment configuration
# Copy to `.env` and fill in your own Supabase project. Vite only exposes
# variables that start with VITE_.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLIC anon (publishable) key. Safe to ship in a browser: every table is
# protected by Row Level Security. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key

# If your Edge Functions are deployed under a custom prefix, override this:
# VITE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1
